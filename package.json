{
  "name": "hakilidia-bot-blockly-ia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "BlocklyDuino-v2-react"
  ],
  "scripts": {
    "sync-blockly": "node packages/blockly-static/src/sync-blockly.mjs",
    "dev:web": "npm run sync-blockly && npm run dev -w blocklyduino-v2-react",
    "dev:ai": "npm run dev -w @blocklyduino/ai-service",
    "dev:service": "npm run dev -w @blocklyduino/arduino-service",
    "build:shared": "npm run build -w @blocklyduino/shared",
    "build:blockly-static": "npm run sync-blockly",
    "build:web": "npm run build -w blocklyduino-v2-react",
    "build:ai": "npm run build -w @blocklyduino/ai-service",
    "build:service": "npm run build -w @blocklyduino/arduino-service",
    "build:all": "npm run build:shared && npm run build:blockly-static && npm run build:web && npm run build:ai && npm run build:service",
    "lint": "npm run lint -w blocklyduino-v2-react"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
