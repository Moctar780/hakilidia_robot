{
  "name": "blocklyduino-v2-react",
  "private": true,
  "version": "0.1.0",
  "description": "Blockly IA - Interface de programmation robotique par blocs",
  "author": "Hakilidia",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "sync-blockly": "npm run sync -w @blocklyduino/blockly-static",
    "predev": "npm run sync-blockly",
    "dev": "vite",
    "prebuild": "npm run sync-blockly",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "electron:dev": "ELECTRON_DEV=true npx electron .",
    "electron:preview": "npm run build && npx electron .",
    "electron:build:win": "npm run build && npx electron-builder --win --x64",
    "electron:build:linux": "npm run build && npx electron-builder --linux --x64",
    "electron:build:mac": "npm run build && npx electron-builder --mac --x64",
    "electron:build:all": "npm run build && npx electron-builder --win --linux --mac --x64"
  },
  "dependencies": {
    "@blocklyduino/shared": "file:../packages/shared",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "@tailwindcss/vite": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "three": "^0.185.0"
  },
  "build": {
    "appId": "cc.hakilidia.blocklyia",
    "productName": "Blockly IA",
    "electronVersion": "43.0.0",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": null,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        }
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
